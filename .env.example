# Copy to .env and fill in. Never commit the real .env.

# ── Required ────────────────────────────────────────────────────────────────

# Postgres connection string. Any provider works (Neon, Supabase, Railway, RDS).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Signs the session cookie. Generate with: openssl rand -hex 32
# The server refuses to boot in production without this.
SESSION_SECRET=

# ── Stripe ──────────────────────────────────────────────────────────────────
# The app boots without these, but checkout, the billing portal and webhooks
# will return errors until they are set. Use test-mode keys (sk_test_...) until
# the live account is ready.

# Dashboard -> Developers -> API keys -> Secret key
STRIPE_SECRET_KEY=

# Dashboard -> Developers -> Webhooks -> add endpoint:
#   https://YOUR_DOMAIN/api/stripe/webhook
# Subscribe it to at least:
#   checkout.session.completed
#   customer.subscription.updated
#   customer.subscription.deleted
# Then copy the endpoint's signing secret (whsec_...) here.
STRIPE_WEBHOOK_SECRET=

# Optional but recommended in production. The price ID for the Producers Circle
# Pro membership. Without it the checkout route falls back to searching Stripe
# for a recurring price whose product is named "Producers Circle Pro", which
# relies on Stripe's eventually-consistent search index.
# Create the product with: npx tsx scripts/seed-producers-circle.ts
STRIPE_PRICE_ID=

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Password reset and email confirmation. With these unset the app still runs
# and the flow still works — the message is written to the server log instead
# of being delivered, so you can copy the link from there in development.

# resend.com -> API Keys. Free tier covers 3,000/month but caps at 100/day.
RESEND_API_KEY=

# Verified sender, e.g. "Producers Circle <no-reply@yourdomain.com>".
# The domain must be verified in Resend (SPF + DKIM) or mail will land in spam.
EMAIL_FROM=

# Absolute base URL used to build links in emails. Without it the app falls
# back to the incoming request's own host, which is wrong behind some proxies.
APP_BASE_URL=https://yourdomain.com

# ── Object storage (Cloudflare R2) ──────────────────────────────────────────
# Stems, artwork and audio. Uploads go straight from the browser to R2 using a
# short-lived signed URL, so files never pass through this server. With these
# unset the app runs but upload endpoints return 503.
#
# Cloudflare dashboard -> R2 -> Manage API tokens -> Create API token
# (Object Read & Write, scoped to the bucket below).

# The hex account id shown in the R2 overview / endpoint URL.
R2_ACCOUNT_ID=

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Bucket name. Keep it PRIVATE — no public access policy. Everything is served
# through short-lived signed URLs after this app checks who is asking.
R2_BUCKET=guild-media

# Optional. Points the S3 client at a different endpoint, for tests against a
# local S3-compatible server. Leave unset to talk to R2.
# R2_ENDPOINT=

# ── Optional ────────────────────────────────────────────────────────────────

# Port to listen on. Defaults to 5000.
PORT=5000

# ── Notes ───────────────────────────────────────────────────────────────────
#
# Demo accounts (alice/bob/zara/malik) are seeded only outside production, and
# the production build hardcodes NODE_ENV=production, so a deployed instance
# never creates them. Locally they log in with the password set by
# DEV_SEED_PASSWORD in server/routes.ts.
#
# The first ministry (admin) account on a live database must be granted by
# hand, since /api/admin/grant-ministry requires an existing ministry user:
#   UPDATE users SET roles = array_append(roles, 'ministry') WHERE username = 'you';
